pipeline {
    agent any

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'deploy-docker', url: 'https://github.com/yourusername/your-repo.git'
            }
        }
        stage('Run Ansible Playbook') {
            steps {
                sh 'ansible-playbook -i inventory web-deploy.yml'
            }
        }
    }
}
